# =============================================================================
# Solana Token Analyzer Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (send /start to @userinfobot to get it)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# Scanning Configuration
# -----------------------------------------------------------------------------
# How often to scan for new signals (in milliseconds)
# Default: 120000 (2 minutes). Minimum: 60000 (1 minute)
SCAN_INTERVAL_MS=120000

# Minimum volume in USD for a token to be considered
MIN_VOLUME_USD=50000

# Maximum market cap in USD (filter out large-cap tokens)
MAX_MARKET_CAP_USD=5000000

# Minimum liquidity in USD required for entry
MIN_LIQUIDITY_USD=25000

# Volume spike multiplier required (e.g., 5 = 5x volume increase)
VOLUME_SPIKE_MULTIPLIER=5

# Minimum price change percentage in the last hour to qualify as momentum
MIN_PRICE_CHANGE_PERCENT=10

# Minimum signal confidence score (0-100) to send an alert
MIN_SIGNAL_SCORE=60

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Path to SQLite database file
DB_PATH=./data/signals.db

# How long to remember a signal before allowing re-alert (in milliseconds)
# Default: 3600000 (1 hour)
SIGNAL_COOLDOWN_MS=3600000

# -----------------------------------------------------------------------------
# Backtesting Mode
# -----------------------------------------------------------------------------
# Set to "true" to run in backtesting mode (no Telegram alerts sent)
BACKTEST_MODE=false
